---
import SiteLayout from "../layouts/SiteLayout.astro";
import Button from "../components/Button.astro";

const phone = "34643515820";

const buildWhatsApp = (message: string) =>
  `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;

const kidsSizes = ["3/4", "5/6", "7/8", "9/11", "12/14"];
const adultSizes = ["XS", "S", "M", "L", "XL", "XXL", "XXXL"];

interface ApparelItem {
  season?: string;
  title: string;
  description: string;
  image: { src: string; alt: string };
  prices: { label?: string; value: string }[];
  fit: string;
  whatsapp: string;
}

const apparel: ApparelItem[] = [
  {
    season: "Temporada 26-27",
    title: "Camiseta de temporada",
    description:
      "Camiseta deportiva con logos del club.",
    image: {
      src: "/images/tienda/camiseta-temporada-26-27.webp",
      alt: "Camiseta roja de la temporada 26/27 de Madrid Cheer Athletics: delante, el nombre del club en letras blancas; detrás, óvalo con siete estrellas en la parte alta de la espalda.",
    },
    prices: [
      { label: "Niño", value: "15 €" },
      { label: "Adulto", value: "20 €" },
    ],
    fit: "adulto, chico recto y chica entallado",
    whatsapp: "Hola, me interesa la camiseta de temporada",
  },
  {
    title: "Sudadera Blanca",
    description:
      "Sudadera con capucha color blanco.",
    image: {
      src: "/images/tienda/sudadera-blanca.webp",
      alt: "Sudadera blanca con capucha de Madrid Cheer Athletics: delante, óvalo rojo con siete estrellas; detrás, logo circular rojo con la M y el nombre del club.",
    },
    prices: [{ value: "28 €" }],
    fit: "recto, sin distinción de chico y chica",
    whatsapp: "Hola, me interesa la sudadera blanca",
  },
  {
    title: "Sudadera Roja",
    description:
      "Sudadera con capucha color rojo.",
    image: {
      src: "/images/tienda/sudadera-roja.webp",
      alt: "Sudadera roja con capucha de Madrid Cheer Athletics: delante, óvalo blanco con siete estrellas; detrás, logo circular blanco con la M y el nombre del club.",
    },
    prices: [{ value: "28 €" }],
    fit: "recto, sin distinción de chico y chica",
    whatsapp: "Hola, me interesa la sudadera roja",
  },
];

const sizeGroups = [
  { label: "Niño", sizes: kidsSizes, chip: "normal-case" },
  { label: "Adulto", sizes: adultSizes, chip: "uppercase" },
];

const accessories = [
  {
    title: "Pom Poms oficiales",
    description:
      "Pompones profesionales en colores del club. Material metálico, gran volumen.",
    sizes: ["Talla única"],
    gradient: "from-mca-red-dark to-mca-navy",
    whatsapp: "Hola, me interesan los pom poms oficiales",
  },
  {
    title: "Mochila Madrid Cheer Athletics",
    description:
      "Mochila deportiva con compartimentos y logo bordado. Color negro con detalles en rojo.",
    sizes: ["Talla única"],
    gradient: "from-mca-navy-dark to-mca-red",
    whatsapp: "Hola, me interesa la mochila de Madrid Cheer Athletics",
  },
  {
    title: "Botella de agua del club",
    description: "Botella reutilizable con logo del club. Capacidad 750ml.",
    sizes: ["750 ml"],
    gradient: "from-mca-red to-mca-navy",
    whatsapp: "Hola, me interesa la botella de agua del club",
  },
];

const orderSteps = [
  {
    n: "01",
    title: "Contáctanos",
    description:
      "Escríbenos por email, teléfono o WhatsApp indicando los artículos que quieres, tallas y cantidades.",
  },
  {
    n: "02",
    title: "Te confirmamos",
    description:
      "Validamos disponibilidad, te confirmamos precio final y formas de pago disponibles.",
  },
  {
    n: "03",
    title: "Recibe el pedido",
    description:
      "Entrega directa en el club durante los entrenamientos o coordinamos otra opción según convenga.",
  },
];
---

<SiteLayout
 title="Tienda oficial · Madrid Cheer Athletics"
  description="Camisetas y sudaderas oficiales de Madrid Cheer Athletics, club de cheerleading en Madrid. Pide la tuya por WhatsApp."
>
  <!-- HERO -->
  <section class="relative bg-mca-navy-dark text-mca-white overflow-hidden">
    <img
      src="/brand/logo-circular-blanco.png" width="1446" height="1446"
      alt=""
      aria-hidden="true"
      class="absolute -right-24 -bottom-24 w-[28rem] h-[28rem] opacity-5 pointer-events-none"
    />
    <div class="relative max-w-7xl mx-auto px-4 md:px-6 lg:px-8 py-16 md:py-24">
      <p class="text-sm uppercase tracking-widest text-mca-red font-medium mb-4">
        Tienda · Catálogo
      </p>
      <h1 class="text-5xl md:text-7xl leading-none font-display font-bold mb-6 max-w-3xl">
        Equípate con MCA
      </h1>
      <p class="text-lg md:text-xl text-mca-white/70 max-w-2xl">
        Selección de productos oficiales del club y artículos esenciales para
        tu entrenamiento. Los pedidos se gestionan directamente con el club.
      </p>
    </div>
  </section>

  <!-- ROPA OFICIAL -->
  <section class="py-16 md:py-24 bg-mca-white">
    <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <p class="text-sm uppercase tracking-widest text-mca-red font-medium mb-2">
          Ropa oficial del club
        </p>
        <h2 class="text-4xl md:text-5xl font-display font-bold text-mca-navy">
          Lleva el rojo MCA
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          apparel.map((p) => (
            <article class="bg-mca-white border border-mca-slate-100 rounded-sm overflow-hidden flex flex-col">
              <div class="aspect-[3/2] bg-mca-white border-b border-mca-slate-100">
                <img
                  src={p.image.src}
                  width="1536"
                  height="1024"
                  alt={p.image.alt}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-contain"
                />
              </div>

              <div class="p-6 flex flex-col flex-1">
                <p class="h-4 mb-1 text-xs leading-4 uppercase tracking-widest font-medium text-mca-red">{p.season}</p>
                <h3 class="text-2xl mb-2">{p.title}</h3>
                <p class="text-mca-slate-700 mb-4">{p.description}</p>

                <ul class="flex gap-8 mb-4" aria-label="Precio">
                  {p.prices.map((pr) => (
                    <li>
                      <span class="block h-4 mb-0.5 text-xs leading-4 font-medium text-mca-slate-500">{pr.label}</span>
                      <span class="block font-display font-bold text-2xl leading-tight text-mca-red whitespace-nowrap">{pr.value}</span>
                    </li>
                  ))}
                </ul>

                <div class="mb-4">
                  <p class="text-xs uppercase tracking-widest font-medium text-mca-navy mb-2">Tallas</p>
                  {sizeGroups.map((g) => (
                    <div class="mb-3 last:mb-0">
                      <p class="text-xs font-medium text-mca-slate-500 mb-1.5">{g.label}</p>
                      <ul class="flex flex-wrap gap-2">
                        {g.sizes.map((s) => (
                          <li class={`text-xs ${g.chip} tracking-widest font-medium px-2.5 py-1 rounded-sm bg-mca-slate-100 text-mca-slate-700`}>
                            {s}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>

                <p class="text-xs text-mca-slate-700 mb-4">Corte: {p.fit}</p>

                <Button variant="primary" href={buildWhatsApp(p.whatsapp)} target="_blank" rel="noopener noreferrer" class="w-full mt-auto">
                  Pedir por WhatsApp
                </Button>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ACCESORIOS -->
  <section class="py-16 md:py-24 bg-mca-slate-50">
    <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <p class="text-sm uppercase tracking-widest text-mca-red font-medium mb-2">
          Accesorios
        </p>
        <h2 class="text-4xl md:text-5xl font-display font-bold text-mca-navy">
          Para entrenar y representar
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          accessories.map((p) => (
            <article class="bg-mca-white border border-mca-slate-100 rounded-sm overflow-hidden flex flex-col">
              <div class={`aspect-square bg-gradient-to-br ${p.gradient} flex flex-col items-center justify-center gap-3 p-6`}>
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-mca-white/40" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                  <circle cx="8.5" cy="8.5" r="1.5" />
                  <polyline points="21 15 16 10 5 21" />
                </svg>
                <p class="text-mca-white/70 text-xs uppercase tracking-widest text-center">
                  Foto producto<br />Placeholder
                </p>
              </div>

              <div class="p-6 flex flex-col flex-1">
                <h3 class="text-2xl mb-2">{p.title}</h3>
                <p class="text-mca-slate-700 mb-4 flex-1">{p.description}</p>

                <div class="mb-4">
                  <p class="text-xs uppercase tracking-widest font-medium text-mca-navy mb-2">Formato</p>
                  <ul class="flex flex-wrap gap-2">
                    {p.sizes.map((s) => (
                      <li class="text-xs uppercase tracking-widest font-medium px-2.5 py-1 rounded-sm bg-mca-slate-100 text-mca-slate-700">
                        {s}
                      </li>
                    ))}
                  </ul>
                </div>

                <p class="text-sm text-mca-slate-500 italic mb-4">
                  Contacta para precio y disponibilidad
                </p>

                <Button variant="primary" href={buildWhatsApp(p.whatsapp)} target="_blank" rel="noopener noreferrer" class="w-full">
                  Pedir por WhatsApp
                </Button>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CÓMO PEDIR -->
  <section class="py-16 md:py-24 bg-mca-white">
    <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <p class="text-sm uppercase tracking-widest text-mca-red font-medium mb-2">
          Cómo pedir
        </p>
        <h2 class="text-4xl md:text-5xl font-display font-bold text-mca-navy">
          Tres pasos hasta tu pedido
        </h2>
      </div>

      <ol class="grid md:grid-cols-3 gap-6 mb-12">
        {
          orderSteps.map((s) => (
            <li>
              <span class="block font-display text-6xl md:text-7xl text-mca-red leading-none mb-4">
                {s.n}
              </span>
              <h3 class="text-2xl mb-2">{s.title}</h3>
              <p class="text-mca-slate-700">{s.description}</p>
            </li>
          ))
        }
      </ol>

      <div class="bg-mca-slate-50 border-l-4 border-mca-red rounded-sm p-6 md:p-8">
        <p class="text-sm uppercase tracking-widest font-medium text-mca-red mb-2">
          Descuento miembros
        </p>
        <p class="text-mca-navy text-lg">
          Los atletas inscritos en Madrid Cheer Athletics disfrutan de
          condiciones especiales en productos oficiales del club.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="relative bg-mca-red text-mca-white overflow-hidden">
    <img
      src="/brand/logo-circular-blanco.png" width="1446" height="1446"
      alt=""
      aria-hidden="true"
      class="absolute -left-24 -top-24 w-[28rem] h-[28rem] opacity-10 pointer-events-none"
    />
    <div class="relative max-w-7xl mx-auto px-4 md:px-6 lg:px-8 py-16 md:py-24 grid md:grid-cols-2 gap-8 items-center">
      <div>
        <h2 class="text-4xl md:text-5xl font-display font-bold mb-4">
          ¿Listo para hacer tu pedido?
        </h2>
        <p class="text-mca-white/90 text-lg max-w-xl">
          Contáctanos por WhatsApp y te respondemos con precios y disponibilidad.
        </p>
      </div>
      <div class="flex flex-wrap gap-4 md:justify-end">
        <a
          href={buildWhatsApp("Hola, me interesan varios productos de la tienda")}
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-sm bg-mca-white text-mca-red font-body font-medium uppercase tracking-wide text-sm transition-all duration-150 ease-out hover:bg-mca-white/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-mca-white focus-visible:ring-offset-2 focus-visible:ring-offset-mca-red"
        >
          Contactar por WhatsApp
        </a>
        <Button
          variant="ghost"
          href="/contacto"
          class="border-mca-white text-mca-white hover:bg-mca-white/10"
        >
          Otras vías de contacto
        </Button>
      </div>
    </div>
  </section>
</SiteLayout>
