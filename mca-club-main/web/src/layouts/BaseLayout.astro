---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  // Social card image: a path under public/ (1200x630 recommended) and its alt text
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  // false leaves out GA entirely (e.g. /privacidad-modal, shown inside an iframe)
  analytics?: boolean;
}

const SITE = "https://www.madridcheer.com";
const DEFAULT_IMAGE = "/images/og-madrid-cheer-athletics.jpg";

const {
  title = "Madrid Cheer Athletics",
  description = "Club de cheerleading en Madrid. Entrenamientos, equipos competitivos y recreativos. No soñamos con ganar. Entrenamos para hacerlo.",
  image = DEFAULT_IMAGE,
  imageAlt = "Logo de Madrid Cheer Athletics",
  noindex = false,
  analytics = true,
} = Astro.props;

const canonical = `${SITE}${Astro.url.pathname}`;
const imageUrl = new URL(image, SITE).href;

// The club as a whole. Pages with their own entity (e.g. /mca-kids) point to it via this @id.
const club = {
  "@context": "https://schema.org",
  "@type": "SportsClub",
  "@id": `${SITE}/#club`,
  name: "Madrid Cheer Athletics",
  url: `${SITE}/`,
  logo: `${SITE}/brand/logo-circular-rojo.png`,
  image: `${SITE}${DEFAULT_IMAGE}`,
  sport: "Cheerleading",
  telephone: "+34 643 51 58 20",
  email: "hola@madridcheer.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "C. de Vital Aza, 56",
    addressLocality: "Madrid",
    addressRegion: "Madrid",
    postalCode: "28017",
    addressCountry: "ES",
  },
  sameAs: [
    "https://www.instagram.com/mca_cheerleadingclub/",
    "https://www.tiktok.com/@mca_cheerleadingclub",
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Madrid Cheer Athletics" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    {image === DEFAULT_IMAGE && <meta property="og:image:width" content="1200" />}
    {image === DEFAULT_IMAGE && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(club)} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#E31837" />

    <!-- Gochi Hand (mca Kids) loads without blocking the first paint; the other fonts are self-hosted -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gochi+Hand&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Gochi+Hand&display=swap" rel="stylesheet" />
    </noscript>

    <title>{title}</title>
{analytics && (
  <>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-167EYGMGDN"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-167EYGMGDN');
</script>
<script>
  import { initLinkTracking } from "../lib/analytics";
  initLinkTracking();
</script>
  </>
)}
  </head>
  <body class="min-h-screen antialiased">
    <slot />
<!-- MODAL PRIVACIDAD -->
<div id="modal-privacidad" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4">
  <div role="dialog" aria-modal="true" aria-labelledby="modal-privacidad-title" class="relative bg-white rounded-lg w-full max-w-3xl h-[82vh] flex flex-col overflow-hidden">
    <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 shrink-0">
      <span id="modal-privacidad-title" class="text-base font-bold text-mca-navy">Política de Privacidad</span>
      <button type="button" id="modal-privacidad-close" aria-label="Cerrar" class="text-gray-400 hover:text-gray-700 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <iframe src="/privacidad-modal" class="flex-1 w-full min-h-0" title="Política de Privacidad" loading="lazy"></iframe>
  </div>
</div>

<script>
  if (!(window as any).__mcaPrivacyInit) {
    (window as any).__mcaPrivacyInit = true;
    const pModal = document.getElementById('modal-privacidad');
    const pClose = document.getElementById('modal-privacidad-close');
    const openP = () => { pModal?.classList.replace('hidden','flex'); document.body.style.overflow='hidden'; };
    const closeP = () => { pModal?.classList.replace('flex','hidden'); document.body.style.overflow=''; };
    document.addEventListener('click', (e) => {
      if ((e.target as Element)?.closest('[data-privacy-modal]')) { e.preventDefault(); openP(); }
    });
    pClose?.addEventListener('click', closeP);
    pModal?.addEventListener('click', (e) => { if (e.target === pModal) closeP(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeP(); });
  }
</script>
  </body>
</html>
