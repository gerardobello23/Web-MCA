---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { EMAIL_PATTERN } from "../lib/web-forms";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const { title, description, image, imageAlt, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} imageAlt={imageAlt} noindex={noindex}>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />

  <!-- MODAL PRUEBA GRATUITA -->
  <div id="modal-prueba" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4">
    <div role="dialog" aria-modal="true" aria-labelledby="modal-prueba-title" class="relative bg-white rounded-lg max-w-lg w-full max-h-[90vh] overflow-y-auto p-6 md:p-8">
      <button type="button" id="modal-close" aria-label="Cerrar" class="absolute top-4 right-4 text-gray-400 hover:text-gray-700">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <!-- Not a heading: this dialog is in every page's markup and would add a hidden H2 to all of them -->
      <p id="modal-prueba-title" class="text-2xl font-display font-bold uppercase tracking-[0.01em] text-mca-navy mb-1">Reserva tu clase gratuita</p>
      <p id="modal-prueba-subtitle" class="text-sm text-gray-500 mb-6">Sin compromiso. Te confirmamos.</p>

      <form id="prueba-form" class="space-y-4">
        <input type="hidden" name="subject" value="Nueva solicitud de prueba gratuita - Madrid Cheer Athletics">
        <input type="hidden" name="fuente" id="prueba-fuente" value="">

        <div>
          <label for="prueba-nombre" class="block text-sm font-medium text-mca-navy mb-1">Nombre completo <span class="text-mca-red">*</span></label>
          <input type="text" id="prueba-nombre" name="nombre" required maxlength="200" class="w-full px-3 py-2 rounded border border-gray-300 text-mca-navy text-base md:text-sm focus:outline-none focus:border-mca-red">
        </div>

        <div>
          <label for="prueba-email" class="block text-sm font-medium text-mca-navy mb-1">Email <span class="text-mca-red">*</span></label>
          <input type="email" id="prueba-email" name="email" required maxlength="200" pattern={EMAIL_PATTERN} title="Introduce un email válido, por ejemplo nombre@dominio.com" class="w-full px-3 py-2 rounded border border-gray-300 text-mca-navy text-base md:text-sm focus:outline-none focus:border-mca-red">
        </div>

        <div>
          <label for="prueba-telefono" class="block text-sm font-medium text-mca-navy mb-1">Teléfono <span class="text-mca-red">*</span></label>
          <div class="flex gap-2">
            <select id="prefijo-tel" aria-label="Prefijo telefónico" class="px-2 py-2 rounded border border-gray-300 text-mca-navy text-base md:text-sm focus:outline-none focus:border-mca-red bg-white w-32 shrink-0">
              <option value="+34">🇪🇸 +34</option>
              <option value="+57">🇨🇴 +57</option>
              <option value="+52">🇲🇽 +52</option>
              <option value="+54">🇦🇷 +54</option>
              <option value="+58">🇻🇪 +58</option>
              <option value="+51">🇵🇪 +51</option>
              <option value="+56">🇨🇱 +56</option>
              <option value="+593">🇪🇨 +593</option>
              <option value="+1">🇺🇸 +1</option>
              <option value="+44">🇬🇧 +44</option>
              <option value="+33">🇫🇷 +33</option>
              <option value="+49">🇩🇪 +49</option>
              <option value="+39">🇮🇹 +39</option>
              <option value="+351">🇵🇹 +351</option>
              <option value="+31">🇳🇱 +31</option>
              <option value="+32">🇧🇪 +32</option>
              <option value="+41">🇨🇭 +41</option>
              <option value="+43">🇦🇹 +43</option>
              <option value="+48">🇵🇱 +48</option>
              <option value="+40">🇷🇴 +40</option>
              <option value="+30">🇬🇷 +30</option>
              <option value="+380">🇺🇦 +380</option>
              <option value="+7">🇷🇺 +7</option>
              <option value="+90">🇹🇷 +90</option>
              <option value="+86">🇨🇳 +86</option>
              <option value="+81">🇯🇵 +81</option>
              <option value="+82">🇰🇷 +82</option>
              <option value="+91">🇮🇳 +91</option>
              <option value="+55">🇧🇷 +55</option>
              <option value="+598">🇺🇾 +598</option>
              <option value="+595">🇵🇾 +595</option>
              <option value="+591">🇧🇴 +591</option>
              <option value="+503">🇸🇻 +503</option>
              <option value="+502">🇬🇹 +502</option>
              <option value="+504">🇭🇳 +504</option>
              <option value="+505">🇳🇮 +505</option>
              <option value="+506">🇨🇷 +506</option>
              <option value="+507">🇵🇦 +507</option>
              <option value="+1-809">🇩🇴 +1-809</option>
              <option value="+53">🇨🇺 +53</option>
              <option value="+212">🇲🇦 +212</option>
              <option value="+213">🇩🇿 +213</option>
              <option value="+20">🇪🇬 +20</option>
              <option value="+27">🇿🇦 +27</option>
              <option value="+234">🇳🇬 +234</option>
            </select>
            <input type="tel" id="prueba-telefono" name="telefono" required maxlength="43" placeholder="600 000 000" class="flex-1 min-w-0 px-3 py-2 rounded border border-gray-300 text-mca-navy text-base md:text-sm focus:outline-none focus:border-mca-red">
          </div>
        </div>

        <div>
          <label for="prueba-fecha-nacimiento" class="block text-sm font-medium text-mca-navy mb-1">Fecha de nacimiento <span class="text-mca-red">*</span></label>
          <input type="date" id="prueba-fecha-nacimiento" name="fecha_nacimiento" required class="w-full px-3 py-2 rounded border border-gray-300 text-mca-navy text-base md:text-sm focus:outline-none focus:border-mca-red">
        </div>

        <!-- SECCIÓN TUTOR — visible solo si el solicitante es menor de 18 -->
        <div id="tutor-section" class="hidden space-y-4 p-4 bg-blue-50 rounded border border-blue-200">
          <p class="text-sm font-medium text-mca-navy">Datos del padre/madre/tutor legal</p>
          <div>
            <label for="prueba-tutor-nombre" class="block text-sm font-medium text-mca-navy mb-1">Nombre completo del tutor <span class="text-mca-red">*</span></label>
            <input type="text" id="prueba-tutor-nombre" name="tutor_nombre" maxlength="200" class="w-full px-3 py-2 rounded border border-gray-300 text-mca-navy text-base md:text-sm focus:outline-none focus:border-mca-red">
          </div>
          <div>
            <label for="prueba-tutor-relacion" class="block text-sm font-medium text-mca-navy mb-1">Relación con el menor <span class="text-mca-red">*</span></label>
            <select id="prueba-tutor-relacion" name="tutor_relacion" class="w-full px-3 py-2 rounded border border-gray-300 text-mca-navy text-base md:text-sm focus:outline-none focus:border-mca-red bg-white">
              <option value="">Selecciona</option>
              <option value="Padre">Padre</option>
              <option value="Madre">Madre</option>
              <option value="Tutor legal">Tutor legal</option>
            </select>
          </div>
          <div>
            <label for="prueba-tutor-dni" class="block text-sm font-medium text-mca-navy mb-1">DNI/NIE del tutor <span class="text-mca-red">*</span></label>
            <input type="text" id="prueba-tutor-dni" name="tutor_dni" maxlength="20" placeholder="12345678A" class="w-full px-3 py-2 rounded border border-gray-300 text-mca-navy text-base md:text-sm focus:outline-none focus:border-mca-red">
          </div>
        </div>

        <fieldset>
          <legend class="block text-sm font-medium text-mca-navy mb-2">Experiencia <span class="text-mca-red">*</span></legend>
          <div class="space-y-2">
            <label class="flex items-start gap-2 text-sm text-mca-navy cursor-pointer">
              <input type="radio" name="experiencia" value="Sin experiencia" required class="mt-0.5 accent-mca-red"> Nunca practiqué este deporte
            </label>
            <label class="flex items-start gap-2 text-sm text-mca-navy cursor-pointer">
              <input type="radio" name="experiencia" value="Practiqué alguna vez" class="mt-0.5 accent-mca-red"> Practiqué alguna vez
            </label>
            <label class="flex items-start gap-2 text-sm text-mca-navy cursor-pointer">
              <input type="radio" name="experiencia" value="Gimnasia, danza u otro deporte similar" class="mt-0.5 accent-mca-red"> Practiqué gimnasia, danza u otro deporte similar
            </label>
            <label class="flex items-start gap-2 text-sm text-mca-navy cursor-pointer">
              <input type="radio" name="experiencia" value="Nivel 1-3 competitivo" class="mt-0.5 accent-mca-red"> Hice nivel 1; 2 y/o 3 competitivo
            </label>
            <label class="flex items-start gap-2 text-sm text-mca-navy cursor-pointer">
              <input type="radio" name="experiencia" value="Nivel 4-7 competitivo" class="mt-0.5 accent-mca-red"> Hice nivel 4; 5; 6 y/o 7 competitivo
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend class="block text-sm font-medium text-mca-navy mb-2">Rol (puedes elegir varios)</legend>
          <div class="space-y-2">
            <label class="flex items-center gap-2 text-sm text-mca-navy cursor-pointer">
              <input type="checkbox" name="rol_base" value="Base" class="accent-mca-red"> Soy base (principal, secundaria o spotter)
            </label>
            <label class="flex items-center gap-2 text-sm text-mca-navy cursor-pointer">
              <input type="checkbox" name="rol_flyer" value="Flyer" class="accent-mca-red"> Soy flyer
            </label>
            <label class="flex items-center gap-2 text-sm text-mca-navy cursor-pointer">
              <input type="checkbox" name="rol_gimnasia" value="Gimnasia" class="accent-mca-red"> Hago gimnasia (básica o avanzada)
            </label>
          </div>
        </fieldset>

        <div>
          <label for="prueba-condiciones-medicas" class="block text-sm font-medium text-mca-navy mb-1">Condiciones médicas y/o lesiones <span class="text-mca-red">*</span></label>
          <input type="text" id="prueba-condiciones-medicas" name="condiciones_medicas" placeholder="Escribe 'Ninguna' si no tienes" required maxlength="1000" class="w-full px-3 py-2 rounded border border-gray-300 text-mca-navy text-base md:text-sm focus:outline-none focus:border-mca-red">
        </div>

        <div>
          <label for="prueba-comentarios" class="block text-sm font-medium text-mca-navy mb-1">Comentarios, preguntas o dudas</label>
          <textarea id="prueba-comentarios" name="comentarios" rows="3" maxlength="2000" class="w-full px-3 py-2 rounded border border-gray-300 text-mca-navy text-base md:text-sm focus:outline-none focus:border-mca-red"></textarea>
        </div>

        <!-- CONSENTIMIENTO ADULTO -->
        <label id="privacidad-adulto" class="flex items-start gap-2 cursor-pointer">
          <input type="checkbox" name="privacidad" required class="mt-0.5 accent-mca-red shrink-0">
          <span class="text-sm text-mca-navy">Acepto la <a href="/privacidad" data-privacy-modal class="underline hover:text-mca-red">política de privacidad</a></span>
        </label>

        <!-- CONSENTIMIENTO TUTOR — visible solo si el solicitante es menor de 18 -->
        <label id="privacidad-menor" class="hidden flex items-start gap-2 cursor-pointer">
          <input type="checkbox" name="privacidad_menor" class="mt-0.5 accent-mca-red shrink-0">
          <span class="text-sm text-mca-navy">Como padre/madre/tutor legal, consiento el tratamiento de los datos personales y de salud del menor por parte de Madrid Cheer Athletics, conforme a la <a href="/privacidad" data-privacy-modal class="underline hover:text-mca-red">política de privacidad</a>, incluyendo el uso de imágenes en actividades del club (art. 7 LOPDGDD y art. 9 RGPD).</span>
        </label>

        <div id="prueba-feedback" class="hidden rounded p-3 text-sm"></div>

        <button type="submit" class="w-full bg-mca-red text-white font-bold py-3 rounded hover:opacity-90 transition-opacity uppercase tracking-wide">
          Reservar
        </button>
      </form>
    </div>
  </div>

  <!-- TEMPORADA_2026_2027 START — eliminar este bloque cuando cierre la campaña de apertura de inscripciones -->
  <style>
    @media (prefers-reduced-motion: no-preference) {
      #modal-temporada .modal-temporada-card {
        animation: temporada-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
    }
    @keyframes temporada-pop {
      from { opacity: 0; transform: scale(0.92) translateY(10px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
  </style>

  <div id="modal-temporada" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4">
    <div role="dialog" aria-modal="true" aria-labelledby="modal-temporada-title" class="modal-temporada-card relative bg-white rounded-2xl max-w-md w-full overflow-hidden shadow-2xl">

      <div class="absolute top-4 right-4 z-20">
        <span class="inline-block px-4 py-2 rounded-full bg-mca-red text-white text-xs font-black uppercase tracking-[0.15em] whitespace-nowrap shadow-lg animate-pulse">
          ¡Ya disponible!
        </span>
      </div>

      <button type="button" id="modal-temporada-close" aria-label="Cerrar" class="absolute top-3 left-3 z-20 w-8 h-8 flex items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/30 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>

      <div class="bg-gradient-to-br from-mca-navy to-[#0a4d85] px-7 pt-12 pb-8 md:px-8 md:pt-14">
        <p class="text-xs uppercase tracking-[0.2em] text-mca-red font-bold mb-2">Temporada 26/27</p>
        <!-- Not a heading, for the same reason as the free-trial dialog title -->
        <p id="modal-temporada-title" class="text-3xl md:text-[2.25rem] font-display font-black text-white leading-[0.95] uppercase tracking-[0.01em]">
          Inscripciones<br/>abiertas
        </p>
      </div>

      <div class="relative -mt-6 bg-white rounded-t-[1.75rem] px-7 pt-6 pb-7 md:px-8 md:pb-8">
        <p class="text-sm text-gray-600 mb-6 leading-relaxed">
          Toda la información está en el formulario de inscripción. ¿Dudas? Escríbenos a
          <a href="mailto:hola@madridcheer.com" class="text-mca-navy font-semibold hover:underline">hola@madridcheer.com</a>
          o por WhatsApp al
          <a href="https://wa.me/34643515820" target="_blank" rel="noopener noreferrer" class="text-mca-navy font-semibold hover:underline">+34 643 51 58 20</a>.
        </p>
        <a href="/inscripcion" class="block w-full text-center bg-mca-red text-white font-bold py-3.5 rounded-lg hover:opacity-90 active:scale-[0.98] transition-all uppercase tracking-wide text-sm shadow-lg shadow-mca-red/30">
          Inscríbete ahora
        </a>
      </div>
    </div>
  </div>
  <!-- TEMPORADA_2026_2027 END -->

  <script>
import { isTemporadaPopupActive } from "../lib/temporada-popup";
import { ageInMadrid, limitBirthDate, sendToApp, trimTextFields } from "../lib/web-forms";
import { track } from "../lib/analytics";
if (!(window as any).__mcaModalInit) {
  (window as any).__mcaModalInit = true;

    const modal = document.getElementById("modal-prueba");
    const modalClose = document.getElementById("modal-close");
    const pruebaForm = document.getElementById("prueba-form");
    const pruebaFeedback = document.getElementById("prueba-feedback");

    function openModal(e: Event) {
      e.preventDefault();
      const trigger = e.currentTarget as HTMLElement;
      const source = trigger?.getAttribute("data-source") || "";
      const fuenteInput = document.getElementById("prueba-fuente") as HTMLInputElement;
      if (fuenteInput) fuenteInput.value = source;

      const titleEl = document.getElementById("modal-prueba-title");
      const subtitleEl = document.getElementById("modal-prueba-subtitle");
      if (titleEl) titleEl.textContent = "Reserva tu clase gratuita";
      if (subtitleEl) subtitleEl.textContent = "Sin compromiso. Te confirmamos.";
      limitBirthDate(fechaNacInput);

      modal?.classList.remove("hidden");
      modal?.classList.add("flex");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      modal?.classList.add("hidden");
      modal?.classList.remove("flex");
      document.body.style.overflow = "";
    }

    document.querySelectorAll("[data-prueba-modal]").forEach((btn) => {
      btn.addEventListener("click", openModal);
    });

    modalClose?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    pruebaForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = pruebaForm as HTMLFormElement;
      // Spaces are trimmed before validating, so a field with only spaces counts as empty
      trimTextFields(form);
      checkAge();
      if (!form.checkValidity()) { form.reportValidity(); return; }

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = "Enviando..."; }
      const formData = new FormData(form);
      const prefijo = (document.getElementById("prefijo-tel") as HTMLSelectElement)?.value || "+34";
      const telefono = `${prefijo} ${formData.get("telefono") as string}`;

      const roles = [];
      if (formData.get("rol_base")) roles.push("Base");
      if (formData.get("rol_flyer")) roles.push("Flyer");
      if (formData.get("rol_gimnasia")) roles.push("Gimnasia");

      const fechaNac = formData.get("fecha_nacimiento") as string;
      const esMenor = ageInMadrid(fechaNac) < 18;

      // The app computes es_menor and sets status itself; neither is sent
      const payload = {
        nombre: formData.get("nombre"),
        email: formData.get("email"),
        telefono,
        fecha_nacimiento: fechaNac,
        experiencia: formData.get("experiencia"),
        rol: roles.join(", "),
        condiciones_medicas: formData.get("condiciones_medicas"),
        comentarios: formData.get("comentarios"),
        tutor_nombre: esMenor ? formData.get("tutor_nombre") : null,
        tutor_relacion: esMenor ? formData.get("tutor_relacion") : null,
        tutor_dni: esMenor ? formData.get("tutor_dni") : null,
        fuente: formData.get("fuente") || null,
      };

      const result = await sendToApp("/prospects/notify", payload, {
        error: "Error al enviar. Por favor inténtalo de nuevo.",
        network: "Error de conexión. Por favor inténtalo de nuevo.",
      });

      if (pruebaFeedback) pruebaFeedback.classList.remove("hidden");
      if (result.ok) {
        track("envio_prueba_gratuita", { fuente: (formData.get("fuente") as string) || undefined });
        if (pruebaFeedback) {
          pruebaFeedback.className = "rounded p-3 text-sm bg-green-50 text-green-700 border border-green-200";
          pruebaFeedback.textContent = "¡Solicitud enviada! Te contactaremos lo antes posible.";
        }
        form.reset();
      } else {
        if (pruebaFeedback) {
          pruebaFeedback.className = "rounded p-3 text-sm bg-red-50 text-red-700 border border-red-200";
          pruebaFeedback.textContent = result.message;
        }
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = "Reservar"; }
      }
    });

    const fechaNacInput = pruebaForm?.querySelector('input[name="fecha_nacimiento"]') as HTMLInputElement;
    const tutorSection = document.getElementById('tutor-section');
    const privacidadAdulto = document.getElementById('privacidad-adulto');
    const privacidadMenor = document.getElementById('privacidad-menor');
    limitBirthDate(fechaNacInput);

    function checkAge() {
      if (!fechaNacInput?.value) return;
      const esMenor = ageInMadrid(fechaNacInput.value) < 18;
      tutorSection?.classList.toggle('hidden', !esMenor);
      privacidadAdulto?.classList.toggle('hidden', esMenor);
      privacidadMenor?.classList.toggle('hidden', !esMenor);

      const tutorInputs = tutorSection?.querySelectorAll('input, select');
      tutorInputs?.forEach(el => {
        if (esMenor) el.setAttribute('required', 'true');
        else el.removeAttribute('required');
      });

      const checkboxMenor = privacidadMenor?.querySelector('input[type="checkbox"]') as HTMLInputElement;
      if (checkboxMenor) checkboxMenor.required = esMenor;
      const checkboxAdulto = privacidadAdulto?.querySelector('input[type="checkbox"]') as HTMLInputElement;
      if (checkboxAdulto) checkboxAdulto.required = !esMenor;
    }

    fechaNacInput?.addEventListener('change', checkAge);
    fechaNacInput?.addEventListener('input', checkAge);
    fechaNacInput?.addEventListener('blur', checkAge);

    // TEMPORADA_2026_2027 START: inactivo por fecha (ver src/lib/temporada-popup.ts), no borrar: reutilizable
    (function () {
      const modalTemporada = document.getElementById('modal-temporada');
      const closeTemporada = document.getElementById('modal-temporada-close');
      if (!modalTemporada) return;

      function closeTemporadaModal() {
        modalTemporada?.classList.add('hidden');
        modalTemporada?.classList.remove('flex');
        document.body.style.overflow = '';
      }

      // Hidden from TEMPORADA_POPUP_END (Madrid time), checked on every page load.
      if (isTemporadaPopupActive() && !sessionStorage.getItem('temporadaPopupShown')) {
        setTimeout(() => {
          modalTemporada.classList.remove('hidden');
          modalTemporada.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }, 1200);
        sessionStorage.setItem('temporadaPopupShown', '1');
      }

      closeTemporada?.addEventListener('click', closeTemporadaModal);
      modalTemporada.addEventListener('click', (e) => {
        if (e.target === modalTemporada) closeTemporadaModal();
      });
    })();
    // TEMPORADA_2026_2027 END
}
  </script>
</BaseLayout>
